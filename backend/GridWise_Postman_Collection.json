{
  "info": {
    "name": "GridWise API Collection",
    "description": "Comprehensive Postman collection for testing the GridWise EV Mobility Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Stats",
      "item": [
        {
          "name": "Check Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Check Ready Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ready"
          }
        },
        {
          "name": "Get DB Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/stats/database"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Test User\",\n  \"role\": \"USER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Stations",
      "item": [
        {
          "name": "Get All Stations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/stations"
          }
        },
        {
          "name": "Get Nearby Stations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/stations/nearby?lat=37.7749&lng=-122.4194&radius=5000"
          }
        },
        {
          "name": "Create Station",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Downtown Supercharger\",\n  \"location\": { \"type\": \"Point\", \"coordinates\": [-122.4194, 37.7749] },\n  \"address\": \"123 Market St, SF\"\n}"
            },
            "url": "{{baseUrl}}/stations"
          }
        }
      ]
    },
    {
      "name": "Admin Analytics",
      "item": [
        {
          "name": "Get Fleet Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/fleet/stats"
          }
        },
        {
          "name": "Get AI Insights",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/ai-insights/summary"
          }
        }
      ]
    },
    {
      "name": "Machine Learning (Direct API)",
      "item": [
        {
          "name": "ML Service Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:8001/health"
          }
        },
        {
          "name": "Predict Demand",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"2026-09-10T08:00:00Z\",\n  \"stationId\": \"12345\"\n}"
            },
            "url": "http://localhost:8001/predict/demand"
          }
        },
        {
          "name": "Predict Revenue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lag_1_revenue\": 1500.50,\n  \"lag_7_revenue\": 1420.00,\n  \"target_date\": \"2026-09-11\"\n}"
            },
            "url": "http://localhost:8001/predict/revenue"
          }
        }
      ]
    }
  ]
}
